{
  "$defs": {
    "DetectedFramework": {
      "additionalProperties": false,
      "properties": {
        "detection_confidence": {
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "framework_id": {
          "type": "string"
        }
      },
      "required": [
        "framework_id",
        "evidence_ids",
        "detection_confidence"
      ],
      "type": "object"
    },
    "DetectedProvider": {
      "additionalProperties": false,
      "properties": {
        "detection_confidence": {
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pack_status": {
          "$ref": "#/$defs/PackStatus"
        },
        "provider_id": {
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "evidence_ids",
        "detection_confidence",
        "pack_status"
      ],
      "type": "object"
    },
    "PackStatus": {
      "enum": [
        "AVAILABLE",
        "NOT_INSTALLED",
        "NOT_IMPLEMENTED",
        "PARTIAL"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ci_systems": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "detected_frameworks": {
      "items": {
        "$ref": "#/$defs/DetectedFramework"
      },
      "type": "array"
    },
    "detected_providers": {
      "items": {
        "$ref": "#/$defs/DetectedProvider"
      },
      "type": "array"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mcp_configurations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "package_ecosystems": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "refreshed_at": {
      "type": "string"
    },
    "repository_id": {
      "type": "string"
    },
    "repository_root_digest": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "security_packs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "repository_id",
    "repository_root_digest",
    "languages",
    "package_ecosystems",
    "ci_systems",
    "mcp_configurations",
    "detected_providers",
    "detected_frameworks",
    "security_packs",
    "created_at",
    "refreshed_at"
  ],
  "title": "ProjectProfile",
  "type": "object"
}
