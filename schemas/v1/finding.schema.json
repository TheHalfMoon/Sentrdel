{
  "$defs": {
    "AcceptedRiskRecord": {
      "additionalProperties": false,
      "description": "Persisted risk-acceptance record. Epoch seconds avoid accepting arbitrary\nunparsed timestamp strings at the authority boundary.",
      "properties": {
        "authorization_ref": {
          "type": "string"
        },
        "created_at_unix_seconds": {
          "format": "int64",
          "type": "integer"
        },
        "evidence_basis": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expires_at_unix_seconds": {
          "format": "int64",
          "type": "integer"
        },
        "owner": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "owner",
        "reason",
        "created_at_unix_seconds",
        "expires_at_unix_seconds",
        "authorization_ref",
        "evidence_basis"
      ],
      "type": "object"
    },
    "EpistemicState": {
      "enum": [
        "DETECTED",
        "CORROBORATED",
        "CONTESTED",
        "PROVEN",
        "UNPROVEN",
        "UNVERIFIABLE"
      ],
      "type": "string"
    },
    "Severity": {
      "enum": [
        "BLOCK",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "type": "string"
    },
    "WorkflowState": {
      "enum": [
        "NEW",
        "TRIAGED_FIX_NOW",
        "TRIAGED_DEFER",
        "ACCEPTED",
        "SUPPRESSED",
        "FIX_PROPOSED",
        "FIX_VERIFIED",
        "FIX_REGRESSED",
        "CLOSED"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted persistence/wire record. Acceptance requires validation against a\nruntime reconciler authority; states beyond NEW additionally require a\nruntime workflow authorization.",
  "properties": {
    "accepted_risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptedRiskRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "affected_subjects": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "category": {
      "type": "string"
    },
    "contradiction_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "epistemic_state": {
      "$ref": "#/$defs/EpistemicState"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "finding_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "first_seen_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "impact_statement": {
      "type": "string"
    },
    "last_seen_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "primary_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconciler_authority_id": {
      "type": "string"
    },
    "reconciler_configuration_digest": {
      "type": "string"
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "workflow_authority_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow_authorization_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow_state": {
      "$ref": "#/$defs/WorkflowState"
    }
  },
  "required": [
    "finding_id",
    "reconciler_authority_id",
    "reconciler_configuration_digest",
    "schema_version",
    "fingerprint",
    "title",
    "impact_statement",
    "category",
    "severity",
    "epistemic_state",
    "evidence_ids",
    "contradiction_ids",
    "affected_subjects",
    "updated_at",
    "workflow_state"
  ],
  "title": "FindingRecord",
  "type": "object"
}
