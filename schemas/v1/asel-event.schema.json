{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "type": "string"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "actor_type",
        "id"
      ],
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "USER",
        "AGENT",
        "TOOL",
        "SYSTEM"
      ],
      "type": "string"
    },
    "EnforcementFidelity": {
      "enum": [
        "ENFORCED",
        "PARTIAL",
        "ADVISORY"
      ],
      "type": "string"
    },
    "EventKind": {
      "enum": [
        "mcp.discovery",
        "mcp.invocation",
        "git.operation",
        "approval",
        "denial",
        "tool.result",
        "guard.error",
        "prompt.input",
        "model.request",
        "file.read",
        "file.write",
        "file.edit",
        "shell.command",
        "subprocess.spawn",
        "network.access",
        "package.install",
        "dependency.change",
        "secret.access",
        "env.access",
        "ci.change",
        "iac.change"
      ],
      "type": "string"
    },
    "PolicyDecisionClaim": {
      "additionalProperties": false,
      "description": "Untrusted/deserializable policy result. A claim is not an authoritative\ndecision until bound to a runtime-selected trusted authority and action.",
      "properties": {
        "action_digest": {
          "type": "string"
        },
        "decided_at": {
          "type": "string"
        },
        "enforcement_fidelity": {
          "$ref": "#/$defs/EnforcementFidelity"
        },
        "kernel_invariant_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy_version_digests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "schema_version",
        "verdict",
        "enforcement_fidelity",
        "reason_codes",
        "rule_ids",
        "kernel_invariant_ids",
        "policy_version_digests",
        "action_digest",
        "decided_at"
      ],
      "type": "object"
    },
    "PolicyDecisionRecord": {
      "additionalProperties": false,
      "description": "Persistence/wire representation. Deserializing this remains untrusted until\n`PolicyDecision::try_from_record` rebinds it to the expected authority/action.",
      "properties": {
        "authority_configuration_digest": {
          "type": "string"
        },
        "authority_id": {
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/PolicyDecisionClaim"
        },
        "decision_id": {
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "authority_id",
        "authority_configuration_digest",
        "claim"
      ],
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "ALLOW",
        "ASK",
        "DENY",
        "UNDECIDABLE"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted wire/persistence record. If it embeds a policy decision, callers\nmust supply the trusted policy authority/action binding before acceptance.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "event_hash": {
      "type": "string"
    },
    "intent_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "params_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyDecisionRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_event_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "result_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "sequence": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "type": "string"
    },
    "target": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "event_hash",
    "schema_version",
    "session_id",
    "sequence",
    "timestamp",
    "actor",
    "kind",
    "target",
    "provenance"
  ],
  "title": "AgentSecurityEventRecord",
  "type": "object"
}
